---
// Self-hosted fonts (same families/weights the site previously pulled from
// Google Fonts) — bundled locally so no render-blocking third-party request.
import '@fontsource/cormorant-garamond/300.css';
// A címsorok dőlt 300-as betűje: enélkül az előtöltött fájl kárba megy, és a cím (LCP) egy késve betöltött betűre vár.
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
// Inter változó betűként: 300–700 egyetlen fájlban karakterkészletenként (8 külön fájl helyett 2).
import '@fontsource-variable/inter/wght.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import heroFontUrl from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url';
import heroFontExtUrl from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-ext-300-italic.woff2?url';
import { PUBLIC_GTM_ID } from 'astro:env/client';
import CookieConsent from '../components/shared/CookieConsent.astro';

interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	noindex?: boolean;
	pageType?: 'website' | 'article';
}

const {
	title,
	description = 'Hovorka-Miskolczi Kinga sminkmester, sminktetováló és oktató Szegeden és Budapesten.',
	canonicalPath = Astro.url.pathname,
	image = 'https://bgumoxbjyuzc6ytp.public.blob.vercel-storage.com/home/main_hero.webp',
	noindex = false,
	pageType = 'website',
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.kingamiskolczi.com');
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${siteUrl}#kinga`,
			name: 'Hovorka-Miskolczi Kinga',
			url: siteUrl.toString(),
			jobTitle: 'Sminkmester, sminktetováló és oktató',
			sameAs: [
				'https://www.instagram.com/sminktetovalas_miskolczikinga/',
				'https://www.instagram.com/miskolczikinga_makeup_school/',
				'https://www.facebook.com/Miskolczikingamakeupschool',
			],
		},
		{
			'@type': 'BeautySalon',
			'@id': `${siteUrl}#business`,
			name: 'Hovorka-Miskolczi Kinga',
			url: siteUrl.toString(),
			telephone: '+36307094370',
			email: 'hmiskolczi@gmail.com',
			founder: { '@id': `${siteUrl}#kinga` },
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'Barcsay Károly utca 7. A ép. 1.',
				postalCode: '6726',
				addressLocality: 'Szeged',
				addressCountry: 'HU',
			},
		},
	],
};

// GTM only in production builds, so local dev doesn't pollute GA4 / Meta data.
const gtmId = import.meta.env.PROD ? PUBLIC_GTM_ID : undefined;
---

<!doctype html>
<html lang="hu">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/favicon-32x32.png" />
		<link rel="preload" href={heroFontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
		<link rel="preload" href={heroFontExtUrl} as="font" type="font/woff2" crossorigin="anonymous" />
		<meta property="og:locale" content="hu_HU" />
		<meta property="og:type" content={pageType} />
		<meta property="og:site_name" content="Hovorka-Miskolczi Kinga" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		{gtmId && (
			<>
				{/* Consent Mode v2 defaults — must run before GTM; CookieConsent.astro sends the update. */}
				<script is:inline>
					window.dataLayer = window.dataLayer || [];
					function gtag() { dataLayer.push(arguments); }
					window.gtag = gtag;
					gtag('consent', 'default', {
						analytics_storage: 'denied',
						ad_storage: 'denied',
						ad_user_data: 'denied',
						ad_personalization: 'denied',
						wait_for_update: 500,
					});
				</script>
				{/* GTM késleltetve: az első interakciókor (görgetés, koppintás, billentyű), vagy legkésőbb
				    2,5 mp-cel a betöltés után töltődik be, így nem lassítja az első megjelenést mobilon.
				    A közben keletkező dataLayer-események (hozzájárulás, időpontkérés) sorban várnak, és utána mind lefutnak. */}
				<script is:inline define:vars={{ gtmId }}>
					(function (w, d, id) {
						var loaded = false;
						var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
						function load() {
							if (loaded) return; loaded = true;
							w.dataLayer = w.dataLayer || [];
							w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
							var j = d.createElement('script'); j.async = true;
							j.src = 'https://www.googletagmanager.com/gtm.js?id=' + id;
							d.head.appendChild(j);
						}
						w.__loadGtm = load;
						events.forEach(function (e) { w.addEventListener(e, load, { once: true, passive: true }); });
						function later() { (w.requestIdleCallback || function (cb) { return setTimeout(cb, 1); })(load, { timeout: 1500 }); }
						if (d.readyState === 'complete') setTimeout(later, 2500);
						else w.addEventListener('load', function () { setTimeout(later, 2500); }, { once: true });
					})(window, document, gtmId);
				</script>
			</>
		)}
	</head>
	<body>
		{gtmId && (
			<noscript>
				<iframe
					src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
					height="0"
					width="0"
					style="display:none;visibility:hidden"
				></iframe>
			</noscript>
		)}
		<slot />
		<CookieConsent />
	</body>
</html>

<style is:global>
	@import "../index.css";
</style>
