---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Köszönjük | Hovorka-Miskolczi Kinga">
  <section class="py-16 md:py-24 bg-cream-100 min-h-screen flex items-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 w-full">

      <div class="bg-white rounded-2xl p-10 sm:p-16 border border-cream-200/60 shadow-[0_15px_50px_rgba(20,15,10,0.04)] text-center space-y-8">

        <div class="space-y-4">
          <span class="text-[11px] font-bold tracking-luxury text-gold-500 uppercase block">Köszönjük</span>
          <h1 class="font-serif-lux text-4xl sm:text-5xl font-light text-charcoal-800 tracking-tight">
            Üzenetedet sikeresen megkaptuk.
          </h1>
        </div>

        <p class="text-sm sm:text-base text-charcoal-700/70 font-light leading-relaxed max-w-md mx-auto">
          Kinga 24 órán belül személyesen felveszi veled a kapcsolatot a megadott adatokon. Addig is küldtünk egy automatikus megerősítő e-mailt a fiókodba.
        </p>

        <div class="pt-4">
          <a
            href="/"
            class="inline-flex items-center justify-center py-4 px-10 bg-gold-500 text-charcoal-900 text-xs font-bold tracking-luxury uppercase transition-all duration-500 hover:bg-gold-400 shadow-xl"
          >
            Vissza a főoldalra
          </a>
        </div>

      </div>

    </div>
  </section>
</Layout>
