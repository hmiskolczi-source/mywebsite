---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import InstagramSection from '../components/home/InstagramSection.astro';
import MainCloser from '../components/home/MainCloser';
import Footer from '../components/shared/Footer';
import SminkPricing from '../components/shared/SminkPricing.astro';

// A nyitókép (25) a hero portréja; a többi a galériákban jelenik meg.
const heroPhoto = 25;
const bridal = [2,3,4,5,6,8,9,10,11,12,13,14,15,17,18,19,20,21,22,23,24,28,29];
const editorial = [1,7,16,26,27];
// Elsőre ennyi menyasszonyi kép látszik; a többi a „További menyasszonyi munkák” gombbal nyílik ki.
const featured = 9;
const photo = (number: number) => `/images/bridal/bridal-${String(number).padStart(2, '0')}.webp`;
const watermark = 'https://bgumoxbjyuzc6ytp.public.blob.vercel-storage.com/shared/imagelogo.png';
---

<Layout title="Sminkek és menyasszonyi sminkek | Hovorka-Miskolczi Kinga" description="Menyasszonyi, alkalmi és kreatív sminkek Hovorka-Miskolczi Kinga munkáiból. Nézd meg a képeket, az árakat és kérj időpontot.">
  <div class="min-h-screen bg-cream-100 text-charcoal-900 overflow-x-hidden antialiased">
    <Navbar currentPage="sminkek" />
    <main>
      <!-- Nyitórész: ugyanaz a felépítés, mint a főoldalon, a Sminktetoválás és a Sminkiskola oldalon -->
      <section class="py-16 md:py-24 bg-cream-100 overflow-hidden" aria-labelledby="makeup-title">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-center">
            <div class="lg:w-7/12 flex flex-col justify-center space-y-8 text-center md:text-left">
              <div class="font-system-ui flex flex-wrap items-center justify-center md:justify-start gap-x-8 gap-y-4 text-charcoal-700">
                <span class="text-sm font-bold tracking-widest uppercase">Nemzetközi zsűritag</span>
                <div class="w-px h-4 bg-charcoal-700/20"></div>
                <span class="font-semibold text-sm tracking-wider">Versenyfelkészítő</span>
                <div class="w-px h-4 bg-charcoal-700/20"></div>
                <span class="font-semibold text-sm tracking-wider">3× VB ezüstérmes</span>
                <div class="w-px h-4 bg-charcoal-700/20"></div>
                <span class="font-sans font-black uppercase text-sm tracking-tighter">EB-arany</span>
              </div>

              <h1 id="makeup-title" class="font-serif-lux text-4xl sm:text-5xl lg:text-5xl font-light tracking-tight text-charcoal-800 leading-[1.2]">
                A pillanat, <br />
                <span class="italic text-gold-600">amikor önmagad vagy.</span>
              </h1>

              <p class="font-system-ui text-lg sm:text-xl text-charcoal-700 font-normal leading-relaxed max-w-2xl">
                <span class="font-bold">Menyasszonyi, alkalmi és kreatív sminkek</span> – minden arc, fény és történet más. Nézd meg a munkáimat, és kérj időpontot próbasminkre vagy a nagy napra; <span class="font-bold">kiszállást is vállalok.</span>
              </p>

              <div class="pt-4 flex flex-col sm:flex-row items-center justify-center md:justify-start gap-6">
                <a href="/idopont" class="font-system-ui group relative px-10 py-5 bg-charcoal-800 text-cream-100 text-xs font-bold tracking-luxury uppercase overflow-hidden transition-all duration-500 hover:bg-charcoal-700 rounded-none inline-block">
                  <span class="relative z-10">Időpontot kérek &rarr;</span>
                  <div class="absolute inset-0 bg-gold-400 translate-y-full group-hover:translate-y-0 transition-transform duration-500 opacity-10"></div>
                </a>
                <a href="#smink-arak" class="font-serif-lux italic text-base text-charcoal-700 underline decoration-gold-400/60 underline-offset-4 hover:text-gold-600">Sminkárak megtekintése</a>
              </div>
            </div>

            <div class="lg:w-5/12 w-full">
              <div class="rounded-lg overflow-hidden shadow-lg bg-charcoal-900 aspect-[3/4] relative">
                <img src={photo(heroPhoto)} alt="Menyasszonyi smink elegáns konttyal" width="3808" height="5712" fetchpriority="high" class="w-full h-full object-cover" />
                <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 pointer-events-none">
                  <img src={watermark} width="32" height="32" alt="" class="h-6 w-auto sm:h-8 opacity-80" referrerpolicy="no-referrer" decoding="async" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="menyasszonyi" class="py-16 md:py-24 bg-cream-100 scroll-mt-24" aria-labelledby="bridal-title">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12">
            <div class="space-y-4">
              <span class="text-[11px] font-bold tracking-luxury text-gold-500 uppercase block">Menyasszonyi munkák</span>
              <h2 id="bridal-title" class="font-serif-lux text-4xl sm:text-5xl lg:text-6xl font-light text-charcoal-800 tracking-tight leading-[1.1]">
                Menyasszonyi <span class="italic">sminkek.</span>
              </h2>
            </div>
            <p class="font-system-ui text-base text-charcoal-700 leading-relaxed max-w-sm">Természetes ragyogás, finom részletek és karakteres tekintetek. Kattints egy fotóra a teljes kép megnyitásához.</p>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-5 lg:gap-7">
            {bridal.slice(0, featured).map((number, index) => (
              <a href={photo(number)} target="_blank" rel="noopener" aria-label={`Menyasszonyi sminkmunka ${index + 1}: teljes kép`} class="block group overflow-hidden rounded-lg shadow-sm bg-cream-200">
                <img src={photo(number)} alt={`Menyasszonyi sminkmunka, ${index + 1}. kép`} loading="lazy" decoding="async" class="block w-full aspect-[4/5] object-cover transition-transform duration-500 group-hover:scale-[1.025]" />
              </a>
            ))}
          </div>
          <details class="more-photos mt-10">
            <summary class="font-system-ui mx-auto w-fit cursor-pointer list-none px-10 py-4 border border-charcoal-800 text-charcoal-800 text-xs font-bold tracking-luxury uppercase hover:bg-charcoal-800 hover:text-cream-100 transition-colors">
              <span class="when-closed">További menyasszonyi munkák ({bridal.length - featured}) ↓</span>
              <span class="when-open">Kevesebb kép ↑</span>
            </summary>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-5 lg:gap-7 mt-10">
              {bridal.slice(featured).map((number, index) => (
                <a href={photo(number)} target="_blank" rel="noopener" aria-label={`Menyasszonyi sminkmunka ${featured + index + 1}: teljes kép`} class="block group overflow-hidden rounded-lg shadow-sm bg-cream-200">
                  <img src={photo(number)} alt={`Menyasszonyi sminkmunka, ${featured + index + 1}. kép`} loading="lazy" decoding="async" class="block w-full aspect-[4/5] object-cover transition-transform duration-500 group-hover:scale-[1.025]" />
                </a>
              ))}
            </div>
          </details>
        </div>
      </section>

      <section class="py-16 md:py-24 bg-cream-100" aria-labelledby="editorial-title">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mb-12 space-y-4">
            <span class="text-[11px] font-bold tracking-luxury text-gold-500 uppercase block">Alkalmi és kreatív munkák</span>
            <h2 id="editorial-title" class="font-serif-lux text-4xl sm:text-5xl lg:text-6xl font-light text-charcoal-800 tracking-tight leading-[1.1]">
              Alkalmi és <span class="italic">kreatív sminkek.</span>
            </h2>
          </div>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-5">
            {editorial.map((number, index) => <a href={photo(number)} target="_blank" rel="noopener" aria-label={`Alkalmi vagy kreatív sminkmunka ${index + 1}: teljes kép`} class="block group overflow-hidden rounded-lg shadow-sm bg-cream-200"><img src={photo(number)} alt={`Alkalmi vagy kreatív sminkmunka, ${index + 1}. kép`} loading="lazy" decoding="async" class="block w-full aspect-[3/4] object-cover transition-transform duration-500 group-hover:scale-[1.035]" /></a>)}
          </div>
        </div>
      </section>

      <SminkPricing />
    </main>
    <InstagramSection />
    <MainCloser />
    <Footer client:visible />
  </div>
  <style>
    .more-photos summary::-webkit-details-marker { display: none; }
    .more-photos .when-open, .more-photos[open] .when-closed { display: none; }
    .more-photos[open] .when-open { display: inline; }
  </style>
</Layout>
