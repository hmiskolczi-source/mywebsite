---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/shared/Navbar.astro';
import Pricing from '../components/sminktetovalas/Pricing';
import AcademyPricing from '../components/academy/v2/AcademyPricing';
import MainCloser from '../components/home/MainCloser';
import InstagramSection from '../components/home/InstagramSection.astro';
import Footer from '../components/shared/Footer';
import SminkPricing from '../components/shared/SminkPricing.astro';
---

<Layout title="Árak | Hovorka-Miskolczi Kinga" description="Alkalmi és menyasszonyi sminkek, sminktetoválási kezelések és sminkiskolai képzések árlistája Hovorka-Miskolczi Kingánál.">
  <div class="min-h-screen bg-cream-100 selection:bg-gold-200 selection:text-charcoal-900 overflow-x-hidden antialiased">
    <Navbar currentPage="arak" />
    <main>
      <section class="max-w-4xl mx-auto px-5 pt-16 md:pt-24 text-center">
        <span class="block text-xs tracking-luxury uppercase text-gold-700 font-bold mb-3">Kinga Miskolczi Makeup Artist</span>
        <h1 class="editorial-page-title text-charcoal-900 mb-6">Szolgáltatásaim és <em class="text-gold-700">áraim</em></h1>
        <p class="text-charcoal-700 text-base max-w-2xl mx-auto mb-8">A sminkek, a sminktetoválás és a sminkiskola díjai külön, könnyen áttekinthető részekben.</p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href="#smink-arak" class="px-5 py-3 border border-gold-400 text-charcoal-900 uppercase tracking-widest text-xs font-bold hover:bg-white">Sminkek</a>
          <a href="#pricing" class="px-5 py-3 border border-gold-400 text-charcoal-900 uppercase tracking-widest text-xs font-bold hover:bg-white">Sminktetoválás</a>
          <a href="#academy-pricing" class="px-5 py-3 border border-gold-400 text-charcoal-900 uppercase tracking-widest text-xs font-bold hover:bg-white">Sminkiskola</a>
          <a href="#tovabbi-kepzesek" class="px-5 py-3 border border-gold-400 text-charcoal-900 uppercase tracking-widest text-xs font-bold hover:bg-white">További képzések</a>
        </div>
      </section>
      <SminkPricing showGalleryLink />
      <Pricing client:visible />
      <AcademyPricing client:visible />
      <section id="tovabbi-kepzesek" class="bg-[#eee8df] py-16 md:py-24 scroll-mt-24">
        <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">
          <div class="mb-10">
            <span class="text-xs font-bold tracking-luxury uppercase text-gold-700">Sminkiskola · további lehetőségek</span>
            <h2 class="text-4xl md:text-5xl text-charcoal-900 mt-3">További képzések és díjak</h2>
          </div>
          <div class="grid md:grid-cols-3 gap-5 lg:gap-6 items-stretch">
            <article class="bg-[#faf8f4] border border-[#d9d0c5] p-7 lg:p-9 flex flex-col">
              <span class="text-xs font-bold tracking-wide uppercase text-gold-700">Haladóknak</span>
              <h3 class="text-3xl lg:text-4xl leading-tight mt-7 mb-5 text-charcoal-900">Anyag- és formatechnikai mesterprogram</h3>
              <p class="font-system-ui text-[15px] font-normal text-charcoal-700 leading-relaxed mb-8">Aqua, Tinta, Gel, Creative, Stage Makeup és Color Smokey; csillámokkal, kövekkel és tollakkal.</p>
              <dl class="text-[15px] mt-auto border-t border-[#d9d0c5]"><div class="flex justify-between gap-5 py-3 border-b border-[#d9d0c5]"><dt>Időtartam</dt><dd class="text-right">60 óra · 10 × 6 óra</dd></div><div class="flex justify-between gap-5 py-3 border-b border-[#d9d0c5]"><dt>Létszám</dt><dd class="text-right">Maximum 5 fő</dd></div><div class="flex justify-between gap-5 py-3"><dt>Feltétel</dt><dd class="text-right">Sminkes előképzettség</dd></div></dl>
              <div class="mt-8"><span class="text-xs text-charcoal-700">Képzési díj</span><p class="text-4xl text-charcoal-900 mt-1">800 000 Ft</p></div>
              <a href="/idopont?service=school_advanced" class="self-start mt-8 pb-2 border-b border-charcoal-800 text-xs font-bold uppercase tracking-wide text-charcoal-900">Érdekel a mesterprogram ↗</a>
            </article>
            <article class="bg-[#faf8f4] border border-[#d9d0c5] p-7 lg:p-9 flex flex-col">
              <span class="text-xs font-bold tracking-wide uppercase text-gold-700">Egyéni mentorálás</span>
              <h3 class="text-3xl lg:text-4xl leading-tight mt-7 mb-5 text-charcoal-900">Bajnoki versenyfelkészítés</h3>
              <p class="font-system-ui text-[15px] font-normal text-charcoal-700 leading-relaxed mb-8">Témaválasztás, modellkeresés, begyakorlás és személyre szabott szakmai felkészítés.</p>
              <dl class="text-[15px] mt-auto border-t border-[#d9d0c5]"><div class="flex justify-between gap-5 py-3 border-b border-[#d9d0c5]"><dt>Időkeret</dt><dd class="text-right">2 hónap</dd></div><div class="flex justify-between gap-5 py-3 border-b border-[#d9d0c5]"><dt>Alkalmak</dt><dd class="text-right">Minimum 3 személyes találkozó</dd></div><div class="flex justify-between gap-5 py-3"><dt>Feltétel</dt><dd class="text-right">Sminkes előképzettség</dd></div></dl>
              <dl class="text-[15px] mt-8"><div class="flex justify-between gap-4 py-2"><dt>Hazai verseny</dt><dd class="font-bold text-right">150 000 Ft <small class="font-normal">/szám</small></dd></div><div class="flex justify-between gap-4 py-2"><dt>Nemzetközi verseny</dt><dd class="font-bold text-right">500 000 Ft <small class="font-normal">/szám</small></dd></div></dl>
              <a href="/idopont?service=school_competition" class="self-start mt-8 pb-2 border-b border-charcoal-800 text-xs font-bold uppercase tracking-wide text-charcoal-900">Felkészítést kérek ↗</a>
            </article>
            <article class="bg-[#faf8f4] border border-[#d9d0c5] p-7 lg:p-9 flex flex-col">
              <span class="text-xs font-bold tracking-wide uppercase text-gold-700">Privát kurzus</span>
              <h3 class="text-3xl lg:text-4xl leading-tight mt-7 mb-5 text-charcoal-900">Önsminkelési mesterkurzus</h3>
              <p class="font-system-ui text-[15px] font-normal text-charcoal-700 leading-relaxed mb-8">Bőrápolás, arcformaelemzés, neszesszerszelektálás és közös gyakorlat. Az arcod egyik felét Kinga, a másikat te készíted el.</p>
              <dl class="text-[15px] mt-auto border-t border-[#d9d0c5]"><div class="flex justify-between gap-5 py-3 border-b border-[#d9d0c5]"><dt>Időtartam</dt><dd class="text-right">3 óra</dd></div><div class="flex justify-between gap-5 py-3 border-b border-[#d9d0c5]"><dt>Létszám</dt><dd class="text-right">1–3 fő</dd></div><div class="flex justify-between gap-5 py-3"><dt>Eredmény</dt><dd class="text-right">Saját sminkrutin</dd></div></dl>
              <div class="mt-8"><span class="text-xs text-charcoal-700">Kurzusdíj</span><p class="text-4xl text-charcoal-900 mt-1">60 000 Ft</p></div>
              <a href="/idopont?service=school_self" class="self-start mt-8 pb-2 border-b border-charcoal-800 text-xs font-bold uppercase tracking-wide text-charcoal-900">Privát kurzust szeretnék ↗</a>
            </article>
          </div>
          <p class="font-system-ui text-sm text-charcoal-700 mt-7">Az árak forintban értendők. A képzések részletes bemutatását és a gyakori kérdéseket a <a href="/sminkkepzes" class="underline text-charcoal-900">Sminkiskola oldalon</a> találod.</p>
        </div>
      </section>
    </main>
    <InstagramSection />
    <MainCloser />
    <Footer client:visible />
  </div>
</Layout>
