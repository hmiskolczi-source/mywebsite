---
import { imgProps } from '../../lib/imageOpt';

interface Props {
  currentPage: 'home' | 'sminktetovalas' | 'sminkkepzes' | 'sminkek' | 'arak' | 'idopont';
}

const { currentPage } = Astro.props;
const logo = imgProps(
  'https://bgumoxbjyuzc6ytp.public.blob.vercel-storage.com/shared/footerlogo.png',
  '180px',
);
const links = [
  { href: '/', label: 'Kinga', page: 'home' },
  { href: '/sminktetovalas', label: 'Sminktetoválás', page: 'sminktetovalas' },
  { href: '/sminkkepzes', label: 'Sminkiskola', page: 'sminkkepzes' },
  { href: '/sminkek', label: 'Sminkek', page: 'sminkek' },
  { href: '/arak', label: 'Árak', page: 'arak' },
] as const;
---

<div class="fixed inset-x-0 top-0 h-1 bg-charcoal-900 z-[60]" aria-hidden="true"></div>
<header class="fixed top-1 left-0 right-0 z-50 bg-cream-100 border-b border-cream-300/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[72px] flex items-center justify-between gap-4">
    <a href="/" class="cursor-pointer select-none shrink-0 no-underline" aria-label="Kinga Miskolczi – főoldal">
      <img
        src={logo.src}
        srcset={'srcSet' in logo ? logo.srcSet : undefined}
        sizes="180px"
        width="180"
        height="60"
        alt="Kinga Miskolczi Makeup Artist"
        class="h-[52px] w-auto"
        style="filter: brightness(0)"
        fetchpriority="high"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-[11px] font-sans font-semibold uppercase tracking-[0.12em] ml-auto" aria-label="Fő navigáció">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={currentPage === link.page ? 'page' : undefined}
          class:list={[
            'cursor-pointer transition-colors relative py-2 no-underline uppercase',
            currentPage === link.page
              ? 'text-charcoal-900 after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-gold-400'
              : 'text-charcoal-700 hover:text-gold-700',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 sm:gap-4">
      <button
        type="button"
        data-mobile-menu-button
        aria-label="Mobil menü megnyitása"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        class="lg:hidden text-charcoal-800 p-2 hover:bg-cream-200 rounded transition-colors"
      >
        <svg data-menu-open aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg data-menu-close class="hidden" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>

      <a
        href="/idopont"
        class="hidden lg:block border border-gold-500 text-charcoal-900 px-5 py-3 text-[11px] font-sans font-semibold tracking-[0.14em] uppercase transition-colors hover:bg-gold-100"
      >
        <span>Időpontkérés</span>
      </a>
    </div>

    <nav
      id="mobile-navigation"
      data-mobile-menu
      class="hidden absolute top-full left-0 right-0 bg-cream-100/95 backdrop-blur-md border-b border-cream-300/30 lg:hidden"
      aria-label="Mobil navigáció"
    >
      <div class="flex flex-col items-start px-4 py-4 max-w-7xl mx-auto">
        {links.map((link) => (
          <a
            href={link.href}
            aria-current={currentPage === link.page ? 'page' : undefined}
            class:list={[
              'w-full px-3 py-2 text-sm font-sans font-semibold uppercase tracking-[0.1em] rounded transition-colors no-underline',
              currentPage === link.page
                ? 'bg-charcoal-900 text-cream-50'
                : 'text-charcoal-700 hover:bg-cream-200',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a href="/idopont" aria-current={currentPage === 'idopont' ? 'page' : undefined} class="w-full px-3 py-2 text-sm font-sans font-semibold uppercase tracking-[0.1em] text-charcoal-700 hover:bg-cream-200">Időpontkérés</a>
      </div>
    </nav>
  </div>
</header>
<div class="h-[76px]" aria-hidden="true"></div>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-mobile-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const openIcon = button?.querySelector<HTMLElement>('[data-menu-open]');
  const closeIcon = button?.querySelector<HTMLElement>('[data-menu-close]');

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Mobil menü bezárása' : 'Mobil menü megnyitása');
    menu?.classList.toggle('hidden', !open);
    openIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
  });
</script>
