		--cc-cookie-category-expanded-block-hover-bg: var(--color-cream-200);
		--cc-footer-bg: var(--color-cream-200);
		--cc-footer-color: var(--color-charcoal-700);
		--cc-footer-border-color: var(--color-cream-300);

		--cc-btn-border-radius: 0.5rem;
		--cc-modal-border-radius: 1rem;
	}

	#cc-main .cm__title,
	#cc-main .pm__title {
		font-family: var(--font-serif);
		font-weight: 500;
	}
</style>
