# Másold .env-be (lokálisan), és vedd fel ugyanezeket a Vercel projekt
# Environment Variables között (Production + Preview).

# Google Tag Manager konténer ID (tagmanager.google.com). GTM-ből fut a GA4 és a Meta Pixel,
# ezek ID-ja (G-…, Pixel ID) a GTM-ben van beállítva, ide nem kell.
# Csak production buildben töltődik be.
PUBLIC_GTM_ID="GTM-XXXXXXX"

# Meta Conversions API (szerveroldali Lead esemény). Ha bármelyik hiányzik, a CAPI nem küld semmit.
# Events Manager → Adatforrások → a Pixel ID-ja
META_PIXEL_ID=""
# Events Manager → Beállítások → Conversions API → Hozzáférési token generálása. TITKOS, ne commitold.
META_CAPI_ACCESS_TOKEN=""

# Opcionális, csak teszteléshez: Events Manager → Események tesztelése → teszt kód (pl. TEST12345).
# Élesben hagyd üresen, különben az események nem számítanak bele a riportokba.
META_TEST_EVENT_CODE=""

# Instagram-galéria – a tokenek titkos Production változók a Vercelben.
INSTAGRAM_GRAPH_VERSION=""
INSTAGRAM_SCHOOL_USER_ID=""
INSTAGRAM_SCHOOL_ACCESS_TOKEN=""
INSTAGRAM_PMU_USER_ID=""
INSTAGRAM_PMU_ACCESS_TOKEN=""

# Az időpontkérés Web3Forms Form ID-ja publikus. A böngésző közvetlenül küldi a
# kérést a Web3Formsnak; a Form ID-t Kinga Gmail-címéhez kell aktiválni.
# A változó a build során kerül a kliensbe, ezért Preview és Production környezetben is add meg.
PUBLIC_WEB3FORMS_BOOKING_FORM_ID=""

# A többi kapcsolatfelvételi űrlap jelenlegi szerveroldali Web3Forms változói.
WEB3FORMS_HOME_ACCESS_KEY=""
WEB3FORMS_PMU_ACCESS_KEY=""
WEB3FORMS_ACADEMY_ACCESS_KEY=""
WEB3FORMS_COURSE_ACCESS_KEY=""
